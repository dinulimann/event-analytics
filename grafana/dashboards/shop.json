          "rawSql": "SELECT variant, countIf(checkout AND bought) / countIf(checkout) AS paid FROM (SELECT session_id, any(app_version) AS app_version, any(variant) AS variant, any(channel) AS channel, min(ts) AS first_ts, max(event_name = 'checkout_start') AS checkout, max(event_name = 'purchase') AS bought FROM analytics.events WHERE event_name IN ('checkout_start','purchase') AND $__timeFilter(ts) GROUP BY session_id) GROUP BY variant ORDER BY variant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0.5,
          "max": 0.7
        },
        "overrides": []
      },
      "options": {
