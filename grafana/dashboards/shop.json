    {
      "id": 5,
      "title": "Daily active users",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "rawSql": "SELECT day AS time, uniqMerge(users) AS users FROM analytics.daily_users WHERE day >= toDate($__fromTime) AND day <= toDate($__toTime) GROUP BY day ORDER BY day"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {},
      "description": "From the daily_users materialized view: no scan of the raw events."
    },
    {
      "id": 6,
      "title": "Daily revenue by channel (IDR)",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "rawSql": "SELECT toStartOfDay(ts) AS time, channel, sum(revenue) AS revenue FROM analytics.events WHERE event_name = 'purchase' AND $__timeFilter(ts) GROUP BY time, channel ORDER BY time"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "stacking": {
              "mode": "normal"
            },
            "fillOpacity": 30
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 7,
      "title": "Mobile: checkouts that end in payment, by app version",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "rawSql": "SELECT toStartOfDay(first_ts) AS time, app_version, countIf(checkout AND bought) / countIf(checkout) AS paid FROM (SELECT session_id, any(app_version) AS app_version, any(variant) AS variant, any(channel) AS channel, min(ts) AS first_ts, max(event_name = 'checkout_start') AS checkout, max(event_name = 'purchase') AS bought FROM analytics.events WHERE event_name IN ('checkout_start','purchase') AND $__timeFilter(ts) AND device = 'mobile' GROUP BY session_id) GROUP BY time, app_version HAVING countIf(checkout) >= 50 ORDER BY time"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": {
            "drawStyle": "points",
            "pointSize": 6
          }
        },
        "overrides": []
      },
      "options": {},
      "description": "App 5.2.0 broke payment for most mobile users until 5.2.1 shipped."
    },
    {
      "id": 8,
      "title": "Funnel by channel (sessions)",
      "type": "barchart",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT channel, countIf(level >= 1) AS `viewed product`, countIf(level >= 2) AS `added to cart`, countIf(level >= 3) AS `started checkout`, countIf(level >= 4) AS purchased FROM (SELECT session_id, any(channel) AS channel, windowFunnel(3600)(toDateTime(ts), event_name = 'product_view', event_name = 'add_to_cart', event_name = 'checkout_start', event_name = 'purchase') AS level FROM analytics.events WHERE event_name IN ('product_view','add_to_cart','checkout_start','purchase') AND $__timeFilter(ts) GROUP BY session_id) GROUP BY channel ORDER BY `viewed product` DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "xField": "channel",
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 9,
      "title": "Users still visiting after N weeks, by acquisition channel",
      "type": "barchart",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT channel, round(avg(r[2]), 3) AS `week 1`, round(avg(r[3]), 3) AS `week 2`, round(avg(r[4]), 3) AS `week 4` FROM (SELECT user_id, any(channel) AS channel, retention(week = first_week, week = first_week + 1, week = first_week + 2, week = first_week + 4) AS r FROM (SELECT user_id, channel, toRelativeWeekNum(ts) AS week, min(toRelativeWeekNum(ts)) OVER (PARTITION BY user_id) AS first_week FROM analytics.events WHERE event_name = 'page_view') WHERE first_week <= (SELECT toRelativeWeekNum(max(ts)) FROM analytics.events) - 4 GROUP BY user_id) GROUP BY channel ORDER BY `week 1` DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "xField": "channel",
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "description": "Cohorts of users first seen at least 4 weeks before the end of the data."
    },
    {
      "id": 10,
      "title": "A/B test: checkouts that end in payment",
      "type": "bargauge",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
